# Live Kaggle specialist server (cloudflared). One URL serves every task.
SATQUERY_ML_ENDPOINT=https://kilometers-island-transcripts-police.trycloudflare.com

# Explicit per-task URLs. These match ML_ENDPOINT so a missing fallback still works.
SATQUERY_VLM_ENDPOINT=https://kilometers-island-transcripts-police.trycloudflare.com
SATQUERY_GROUNDING_ENDPOINT=https://kilometers-island-transcripts-police.trycloudflare.com
SATQUERY_CHANGE_ENDPOINT=https://kilometers-island-transcripts-police.trycloudflare.com
SATQUERY_FUSION_ENDPOINT=https://kilometers-island-transcripts-police.trycloudflare.com

SATQUERY_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SATQUERY_STRICT_FORMAT_POLICY=false
SATQUERY_DATA_DIR=.data
SATQUERY_ANALYSIS_MAX_EDGE=512
