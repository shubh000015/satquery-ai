# Copy to backend/.env and edit. Every setting is prefixed SATQUERY_.

# Where uploads, previews and sessions are written.
# SATQUERY_DATA_DIR=.data

# Frontend origins allowed to call the API.
SATQUERY_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Longest edge (px) rasters are decimated to before analysis.
# SATQUERY_ANALYSIS_MAX_EDGE=512

# true  -> reject PNG/JPEG unless a benchmark dataset is declared (spec-strict)
# false -> accept them with a warning, so JPEG demo chips still work
SATQUERY_STRICT_FORMAT_POLICY=false

# Fine-tuned model endpoints. Leave blank to run the heuristic baseline.
# Setting one flips the matching registry row to "wired" and the tool will call
# its run_endpoint adapter.
# SATQUERY_VLM_ENDPOINT=http://localhost:8100/v1        # VQA, captioning, controller
# SATQUERY_GROUNDING_ENDPOINT=http://localhost:8101/v1  # grounding, referring segmentation
# SATQUERY_CHANGE_ENDPOINT=http://localhost:8102/v1     # change masks, change VQA
# SATQUERY_FUSION_ENDPOINT=http://localhost:8103/v1     # optical-SAR fusion
