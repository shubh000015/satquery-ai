# Copy to backend/.env and edit. Every setting is prefixed SATQUERY_.

# Where uploads, previews and sessions are written.
# SATQUERY_DATA_DIR=.data

# Frontend origins allowed to call the API.
SATQUERY_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Longest edge (px) rasters are decimated to before analysis.
# SATQUERY_ANALYSIS_MAX_EDGE=512

# true  -> reject PNG/JPEG unless a benchmark dataset is declared (spec-strict)
# false -> accept them with a warning, so JPEG demo chips still work
SATQUERY_STRICT_FORMAT_POLICY=false

# Specialist model endpoints. Leave blank to run the heuristic baseline.
# The client appends /v1/vqa, /v1/grounding, /v1/change, /v1/fusion itself.
#
# One URL is enough: ml/serve.py hosts every task on one port. On Kaggle run
# ml/notebooks/kaggle_serve_models.ipynb and paste the printed
# https://*.trycloudflare.com URL here:
# SATQUERY_ML_ENDPOINT=https://<subdomain>.trycloudflare.com
#
# Per-task URLs override the shared one when you split servers:
# SATQUERY_VLM_ENDPOINT=https://<subdomain>.trycloudflare.com
# SATQUERY_GROUNDING_ENDPOINT=https://<subdomain>.trycloudflare.com
# SATQUERY_CHANGE_ENDPOINT=https://<subdomain>.trycloudflare.com
# SATQUERY_FUSION_ENDPOINT=https://<subdomain>.trycloudflare.com
#
# Locally: python ml/serve.py --port 8100   (add --no-vlm to skip the 7B model)
# SATQUERY_ML_ENDPOINT=http://localhost:8100
